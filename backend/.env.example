# Personal AI Assistant - Environment Configuration
# Ollama Local Configuration
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_MODEL=mistral:latest
EMBEDDING_MODEL_NAME=nomic-embed-text
DEFAULT_TEMPERATURE=0.2

# Set your Groq API key here (optional / cloud fallback)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Set your MongoDB Atlas Connection URI here (optional)
MONGODB_ATLAS_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority

MONGODB_DB_NAME=personal_ai_assistant
MONGODB_COLLECTION_NAME=knowledge_vectors
MONGODB_INDEX_NAME=vector_index
